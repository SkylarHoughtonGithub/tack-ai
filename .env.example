# Model Providers
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
TYPESAFE_API_KEY=your-typesafe-key-here   # optional — enables Jev decision model for GateNode

## AI Observability — get a token at https://logfire.pydantic.dev
LOGFIRE_TOKEN=

# Application logging
LOG_LEVEL=INFO
LOG_JSON=true   # set false for human-readable console output in development

# Distributed tracing
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=tack-ai

# RAG and memory
DATABASE_URL=postgresql://tack_ai:tack_ai@localhost/tack_ai
OPENFGA_URL=http://localhost:8081
OPENFGA_STORE_ID=        # auto-seeded on first startup; updated in-place by the app
OPENFGA_MODEL_ID=        # auto-seeded on first startup; updated in-place by the app

# OIDC / SSO
OIDC_PROVIDER=google
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_BASE=http://localhost:8000        # base URL of this app
OIDC_ADMIN_EMAILS=you@example.com               # comma-separated admin emails
OIDC_DEFAULT_ROLE=viewer
OIDC_DISCOVERY_URL=                             # required only for OIDC_PROVIDER=oidc
