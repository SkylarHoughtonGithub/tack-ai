ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# Observability — get a token at https://logfire.pydantic.dev
# Omit or leave blank to run without cloud tracing (local only).
LOGFIRE_TOKEN=

# Phase 6 — RAG and memory
# Start services: docker compose up -d
# Then run: uv run python scripts/setup_fga.py
DATABASE_URL=postgresql://tack_ai:tack_ai@localhost/tack_ai
OPENFGA_URL=http://localhost:8081
OPENFGA_STORE_ID=        # output of scripts/setup_fga.py
OPENFGA_MODEL_ID=        # output of scripts/setup_fga.py
